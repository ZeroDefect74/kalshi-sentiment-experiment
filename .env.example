# Reddit API (free, read-only "script" app) -- create at https://www.reddit.com/prefs/apps
# Click "create app", choose type "script", any name/redirect URI (redirect
# URI is unused for this app-only flow but the form requires one, e.g.
# http://localhost:8080). The client_id is the string under the app name;
# the client_secret is labeled "secret".
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=kalshi-sentiment-experiment/1.0 (by /u/YOUR_USERNAME)

# Optional overrides (defaults are reasonable, no need to set these)
# DB_PATH=data/kalshi_sentiment.db
# SNAPSHOT_INTERVAL_HOURS=6
# BASKET_SIZE=40
# EXTREME_LOW=0.10
# EXTREME_HIGH=0.90
# MIN_OPEN_INTEREST=500
# MAX_DAYS_TO_CLOSE=30
# SPIKE_RATIO=2.0
